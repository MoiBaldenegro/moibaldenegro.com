---
// Filosofía de /about (feature 84, REQ-84-13): cierra la página con el lema (en inglés, lang="en")
// y el texto de philosophy dentro de un blockquote (D3). Las comillas son decorativas (CSS).
import type { AboutPhilosophy } from '../../domain/entities/about-profile.ts';

interface Props {
  philosophy: AboutPhilosophy;
}

const { philosophy } = Astro.props;
---

<section class="mx-section" aria-labelledby="about-philosophy-title">
  <h2 id="about-philosophy-title" class="mx-heading mx-heading--lg">Filosofía</h2>
  <blockquote class="mx-quote">
    <p class="mx-quote__text" lang="en">{philosophy.motto}</p>
    <p class="mx-quote__caption">{philosophy.text}</p>
  </blockquote>
</section>
