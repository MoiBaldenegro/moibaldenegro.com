---
// Formación y certificaciones de /about (feature 84, REQ-84-10/11/12): tres bloques con h3
// Educación (sin fechas), Certificaciones (con emisor) e Idiomas (con nivel).
import type { AboutCertification, AboutEducation, AboutLanguage } from '../../domain/entities/about-profile.ts';

interface Props {
  education: readonly AboutEducation[];
  certifications: readonly AboutCertification[];
  languages: readonly AboutLanguage[];
}

const { education, certifications, languages } = Astro.props;
---

<section class="mx-section" aria-labelledby="about-credentials-title">
  <h2 id="about-credentials-title" class="mx-heading mx-heading--lg">Formación y certificaciones</h2>
  <div class="mx-card-grid">
    <article class="mx-card mx-card--interactive mx-group-card">
      <h3 class="mx-group-card__title mx-group-card__title--accent">Educación</h3>
      <ul class="mx-entry-list">
        {education.map((item) => (
          <li><strong class="mx-entry-list__name">{item.degree}</strong><span class="mx-entry-list__meta">{item.institution}</span><span class="mx-entry-list__meta">{item.place}</span></li>
        ))}
      </ul>
    </article>
    <article class="mx-card mx-card--interactive mx-group-card">
      <h3 class="mx-group-card__title mx-group-card__title--accent">Certificaciones</h3>
      <ul class="mx-entry-list">
        {certifications.map((item) => (
          <li><strong class="mx-entry-list__name">{item.name}</strong><span class="mx-entry-list__meta">{item.issuer}</span></li>
        ))}
      </ul>
    </article>
    <article class="mx-card mx-card--interactive mx-group-card">
      <h3 class="mx-group-card__title mx-group-card__title--accent">Idiomas</h3>
      <ul class="mx-entry-list">
        {languages.map((item) => (
          <li><strong class="mx-entry-list__name">{item.name}</strong><span class="mx-entry-list__meta">{item.level}</span></li>
        ))}
      </ul>
    </article>
  </div>
</section>
