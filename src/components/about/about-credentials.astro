---
// Formación y certificaciones de /about (feature 84, REQ-84-10/11/12): tres bloques con h3
// Educación (sin fechas), Certificaciones (con emisor) e Idiomas (con nivel).
import '../../styles/about-credentials.css';
import type { AboutCertification, AboutEducation, AboutLanguage } from '../../domain/entities/about-profile.ts';

interface Props {
  education: readonly AboutEducation[];
  certifications: readonly AboutCertification[];
  languages: readonly AboutLanguage[];
}

const { education, certifications, languages } = Astro.props;
---

<section class="about-credentials" aria-labelledby="about-credentials-title">
  <h2 id="about-credentials-title" class="about-credentials__title">Formación y certificaciones</h2>
  <div class="about-credentials__grid">
    <article class="about-credentials__card">
      <h3 class="about-credentials__heading">Educación</h3>
      <ul class="about-credentials__list">
        {education.map((item) => (
          <li><strong class="about-credentials__name">{item.degree}</strong><span class="about-credentials__meta">{item.institution}</span><span class="about-credentials__meta">{item.place}</span></li>
        ))}
      </ul>
    </article>
    <article class="about-credentials__card">
      <h3 class="about-credentials__heading">Certificaciones</h3>
      <ul class="about-credentials__list">
        {certifications.map((item) => (
          <li><strong class="about-credentials__name">{item.name}</strong><span class="about-credentials__meta">{item.issuer}</span></li>
        ))}
      </ul>
    </article>
    <article class="about-credentials__card">
      <h3 class="about-credentials__heading">Idiomas</h3>
      <ul class="about-credentials__list">
        {languages.map((item) => (
          <li><strong class="about-credentials__name">{item.name}</strong><span class="about-credentials__meta">{item.level}</span></li>
        ))}
      </ul>
    </article>
  </div>
</section>
