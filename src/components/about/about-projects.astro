---
// Proyectos destacados de /about (feature 84, REQ-84-04/05/06): una tarjeta por proyecto de
// about.json con el enlace en el h3 (nombre accesible corto, D1) y su descripción.
import type { AboutProject } from '../../domain/entities/about-profile.ts';

interface Props {
  projects: readonly AboutProject[];
}

const { projects } = Astro.props;
---

<section class="mx-section" aria-labelledby="about-projects-title">
  <h2 id="about-projects-title" class="mx-heading mx-heading--lg">Proyectos destacados</h2>
  <ul class="mx-card-grid">
    {projects.map((project) => (
      <li class="mx-card mx-project-card">
        <h3 class="mx-project-card__name"><a class="mx-project-card__link" href={project.href}>{project.name}<span class="mx-visually-hidden"> (sitio externo)</span></a><span class="mx-project-card__arrow" aria-hidden="true">↗</span></h3>
        <p class="mx-project-card__description">{project.description}</p>
      </li>
    ))}
  </ul>
</section>
