---
// Contenido de /about (feature 84, REQ-84-07/08): h2, la presentación del sitio por slot
// (p.about__intro de REQ-39-05, D4) y una tarjeta enlazada por elemento de content.
import type { AboutContent } from '../../domain/entities/about-profile.ts';

interface Props {
  content: readonly AboutContent[];
}

const { content } = Astro.props;
---

<section class="mx-section" aria-labelledby="about-content-title">
  <h2 id="about-content-title" class="mx-heading mx-heading--lg">Contenido</h2>
  <slot />
  <ul class="mx-card-grid mx-card-grid--2">
    {content.map((item) => (
      <li class="mx-card mx-project-card">
        <h3 class="mx-project-card__name"><a class="mx-project-card__link" href={item.href}>{item.title}</a></h3>
        <p class="mx-project-card__description">{item.description}</p>
      </li>
    ))}
  </ul>
</section>
