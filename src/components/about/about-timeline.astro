---
// Timeline de experiencia de /about (feature 83, REQ-83-03..06): un <li> por puesto en el orden
// de about.json con role (h3), organización · lugar, period en píldora (texto, nunca fechas
// derivadas), logros y, si existe, el resultado destacado con la etiqueta visible «Resultado».
import type { AboutExperience } from '../../domain/entities/about-profile.ts';

interface Props {
  experience: readonly AboutExperience[];
}

const { experience } = Astro.props;
---

<section class="mx-section" aria-labelledby="about-experience-title">
  <h2 id="about-experience-title" class="mx-heading mx-heading--lg">Experiencia</h2>
  <ol class="mx-timeline">
    {experience.map((job) => (
      <li class="mx-timeline-item">
        <article class="mx-card mx-card--interactive">
          <header class="mx-timeline-item__head">
            <h3 class="mx-timeline-item__role">{job.role}</h3>
            <span class="mx-badge">{job.period}</span>
          </header>
          <p class="mx-timeline-item__org">{job.organization} · {job.place}</p>
          <ul class="mx-timeline-item__highlights">
            {job.highlights.map((highlight) => <li>{highlight}</li>)}
          </ul>
          {job.result && (
            <p class="mx-callout"><strong>Resultado:</strong> {job.result}</p>
          )}
        </article>
      </li>
    ))}
  </ol>
</section>
