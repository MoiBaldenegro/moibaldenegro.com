---
// Cifras destacadas de /about (feature 82, REQ-82-11): lista de 4 cifras de about.json
// con el valor en acento y su etiqueta, bajo un h2 mx-visually-hidden.
import type { AboutStat } from '../../domain/entities/about-profile.ts';

interface Props {
  stats: readonly AboutStat[];
}

const { stats } = Astro.props;
---

<section aria-labelledby="about-stats-title">
  <h2 id="about-stats-title" class="mx-visually-hidden">Cifras destacadas</h2>
  <ul class="mx-stats">
    {stats.map((stat) => (
      <li class="mx-stat"><span class="mx-stat__value">{stat.value}</span><span class="mx-stat__label">{stat.label}</span></li>
    ))}
  </ul>
</section>
