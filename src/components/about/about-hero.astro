---
// Hero de /about (feature 82, REQ-82-04..10): foto enmarcada, nombre (único h1), handle,
// titular, ubicación, resumen, enfoque, redes y descarga del CV generado en build (/cv.pdf).
// El h1 llega por el slot name desde about.astro (REQ-39-05: la página declara su único h1).
import type { AboutProfile } from '../../domain/entities/about-profile.ts';
import { heroLinks } from '../../domain/about-links.ts';

interface Props {
  username: string;
  description: string;
  image: string;
  about: AboutProfile;
}

const { username, description, image, about } = Astro.props;
const links = heroLinks(about);
---

<section class="mx-profile-hero" aria-labelledby="about-name">
  <div class="mx-profile-hero__media">
    <img class="mx-photo" src={image} alt={about.photoAlt} width="952" height="960" loading="eager" decoding="async" />
  </div>
  <div class="mx-profile-hero__body">
    <p class="mx-profile-hero__handle">{username}</p>
    <slot name="name" />
    <p class="mx-profile-hero__headline">{about.headline}</p>
    <p class="mx-profile-hero__location">{about.location}</p>
    <p class="mx-profile-hero__summary">{about.summary}</p>
    <p class="mx-profile-hero__focus">{description}</p>
    <div class="mx-profile-hero__actions">
      <ul class="mx-social-list--inline">
        {links.map((link) => (
          <li>
            <a class="mx-button" href={link.href}>
              <svg class="mx-button__icon" aria-hidden="true" focusable="false"><use href={`/assets/svg/sprite.svg#${link.id}`} /></svg>
              {link.label}<span class="mx-visually-hidden"> (sitio externo)</span>
            </a>
          </li>
        ))}
      </ul>
      <a class="mx-button mx-button--accent" href="/cv.pdf" download="moises-baldenegro-cv.pdf">Descargar CV <span aria-hidden="true">↓</span></a>
    </div>
  </div>
</section>
