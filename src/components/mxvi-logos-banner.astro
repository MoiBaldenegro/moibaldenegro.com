---
import "../styles/mxvi-logos-banner.css";

const logos = [
  { id: "mxvi-m", viewBox: "0 0 717 716" },
  { id: "mxvi-x", viewBox: "0 0 805 716" },
  { id: "mxvi-v", viewBox: "0 0 795 716" },
  { id: "mxvi-i", viewBox: "0 0 190 716" },
];
---

<section class="mxvi-logos" aria-hidden="true">
  <div class="mxvi-logos__track">
    {logos.map(({ id, viewBox }) => (
      <svg class={`mxvi-logos__logo mxvi-logos__logo--${id}`} viewBox={viewBox} focusable="false">
        <use href={`/assets/svg/sprite.svg#${id}`} />
      </svg>
    ))}
  </div>
</section>
