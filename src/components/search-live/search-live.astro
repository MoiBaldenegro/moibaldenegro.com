---
import '../../styles/search-results.css';
import '../../styles/search-live.css';
---

<section class="search-live" data-search-live aria-label="Resultados en vivo" hidden>
  <div class="search-results__empty" data-search-empty hidden>
    <p class="search-results__empty-message">No se encontraron resultados para '<span data-search-term></span>'</p>
  </div>
  <ul class="search-results__list" data-search-list hidden></ul>
  <a class="search-live__all" data-search-all href="/search" hidden>Ver todos los resultados</a>
</section>

<script>
  import { initSearchLive } from './search-live.ts';
  document.addEventListener('astro:page-load', () => initSearchLive());
</script>