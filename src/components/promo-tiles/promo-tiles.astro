---
// Sección promocional 2x2 de la home (feature 4 promo-tiles-section, REQ-04-08..19).
// Estática: datos vía PromoTilesRepository y atributos de enlace vía linkAttrs. Feature 12 (REQ-12-10):
// tarjetas promocionales y botones del design system MXVI.
import { PromoTilesRepository } from '../../domain/repositories/promo-tiles-repository.ts';
import { linkAttrs } from '../../domain/promo-tiles.ts';

const tiles = new PromoTilesRepository().getTiles();
---

<section class="mx-promo-grid" aria-labelledby="promo-tiles-title">
  <h2 id="promo-tiles-title" class="mx-visually-hidden">Proyectos y contenido</h2>
  {tiles.map((tile) => (
    <article class="mx-promo-tile" data-tone={tile.tone}>
      <h3 class="mx-promo-tile__title">{tile.title}</h3>
      <p class="mx-promo-tile__subtitle">{tile.subtitle}</p>
      <div class="mx-promo-tile__actions">
        <a class="mx-button mx-button--cta" href={tile.primary.href} {...linkAttrs(tile.primary.href)}>{tile.primary.label}</a>
        <a class="mx-button mx-button--cta-outline" href={tile.secondary.href} {...linkAttrs(tile.secondary.href)}>{tile.secondary.label}</a>
      </div>
      <img class="mx-promo-tile__image" src={tile.image} alt={tile.imageAlt} width="1920" height="1920" loading="lazy" decoding="async" />
    </article>
  ))}
</section>
