---
---

<section class="search-results" aria-label="Resultados de búsqueda">
  <p class="mx-visually-hidden" role="status" aria-live="polite" data-search-status></p>
  <div class="mx-notice" data-search-guide>
    <h2 class="mx-notice__title">Buscar en el catálogo</h2>
    <p class="mx-notice__text">
      Escribe un término en la barra de búsqueda o visita /search?q=término para
      encontrar artículos por título, descripción, etiquetas o contenido.
    </p>
  </div>
  <div class="mx-notice" data-search-empty hidden>
    <p class="mx-notice__text mx-notice__text--lg">No se encontraron resultados para '<span data-search-term></span>'</p>
    <div class="mx-notice__actions"><button type="button" class="mx-button mx-button--quiet" data-search-results-clear>Limpiar búsqueda</button></div>
  </div>
  <ul class="mx-result-list" data-search-list tabindex="-1" hidden></ul>
  <nav class="mx-pagination" data-search-pagination hidden aria-label="Paginación de resultados">
    <button type="button" class="mx-button mx-button--surface" data-search-prev>Anterior</button>
    <span class="mx-pagination__label" data-search-page-label></span>
    <button type="button" class="mx-button mx-button--surface" data-search-next>Siguiente</button>
  </nav>
</section>

<script>
  import { initSearchResults } from './search-results-controller.ts';
  document.addEventListener('astro:page-load', () => initSearchResults());
</script>
