---
import "../styles/hero-card.css";
import type { HeroCard } from "../domain/entities/hero-card.ts";

interface Props {
  card: HeroCard;
}

const { card } = Astro.props;
---

<article class="hero-card" data-color-token={card.colorToken}>
  <header class="card-header">
    <h3>{card.title}</h3>
  </header>

  <div class="card-icon">
    <svg width="32px" height="32px">
      <use xlink:href={card.icon} href={card.icon}/>
    </svg>
  </div>
</article>
