---
import "../styles/latest-articles.css";

import { PostsRepository } from "../domain/repositories/posts-repository.ts";

const posts = (await new PostsRepository().getPosts()).slice(0, 3);
---

<section class="latest-articles" data-latest-scroll>
  <h2 class="latest-articles__heading">Últimos artículos</h2>
  <div class="latest-articles__list" data-latest-track>
    {posts.map((post) => (
      <article class="latest-articles__card">
        <a class="latest-articles__link" href={`/posts/${post.id}`}>
          <img
            class="latest-articles__image"
            src={`/assets/content/${post.img}`}
            alt={post.title}
            loading="lazy"
            transition:name={`img-${post.id}`}
          />
          <h2 transition:name={`title-${post.id}`} class="latest-articles__title">{post.title}</h2>
        </a>
        <p class="latest-articles__meta">Por {post.author} • {post.readtime} min de lectura</p>
        <p class="latest-articles__description">{post.description}</p>
        <div class="latest-articles__tags">
          {post.tags.map((tag) => (
            <span class="latest-articles__tag">#{tag}</span>
          ))}
        </div>
      </article>
    ))}
  </div>
</section>

<script>
  import { initLatestScroll } from "./latest-articles-scroll.ts";
  document.addEventListener("astro:page-load", () => initLatestScroll());
</script>