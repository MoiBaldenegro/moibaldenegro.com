---
import { PostsRepository } from "../domain/repositories/posts-repository.ts";
import { latestPosts } from "../domain/latest-posts.ts";

// La lista visible se recorta a los 3 más recientes en el módulo de dominio
// (REQ-30-01..06): aquí solo imports y paso de datos. Feature 12 (REQ-12-08): tarjetas de artículo
// del design system MXVI; latest-articles queda como gancho del modo horizontal (latest-horizontal.ts).
const posts = latestPosts(await new PostsRepository().getPosts());
---

<section class="mx-page latest-articles">
  <h2 class="mx-heading">Últimos artículos</h2>
  <div class="mx-article-list">
    {posts.map((post) => (
      <article class="mx-article-card">
        <a class="mx-article-card__link" href={`/posts/${post.id}`}>
          <img
            class="mx-media mx-article-card__image"
            src={`/assets/content/${post.img}`}
            alt=""
            width="1376"
            height="768"
            loading="lazy"
            decoding="async"
            transition:name={`img-${post.id}`}
          />
          <h3 transition:name={`title-${post.id}`} class="mx-article-card__title">{post.title}</h3>
        </a>
        <p class="mx-meta">Por {post.author} • {post.readtime} min de lectura</p>
        <p class="mx-article-card__description">{post.description}</p>
        <ul class="mx-tag-list">
          {post.tags.map((tag) => (
            <li class="mx-tag">#{tag}</li>
          ))}
        </ul>
      </article>
    ))}
  </div>
</section>