---
import "../styles/latest-articles.css";

import {  markdownPostRepository } from "../domain/repositories/posts-repository.ts";

const repository = await markdownPostRepository()
const posts = await repository.getPosts();
---

<section class="latest-articles">
  <div class="latest-articles__list">
    {posts.map((post) => (
      <article  class="latest-articles__card">
        <a href={`/posts/${post.id}`} class="latest-articles__link">
          <img
            transition:name={`img-${post.id}`}
            src={`/assets/content/${post.data.img}`}
            alt={post.data.title}
            class="latest-articles__image"
          />
          <h2 transition:name={`title-${post.id}`} class="latest-articles__title">{post.data.title}</h2>
          <p class="latest-articles__description">{post.data.description}</p>
        </a>
      </article>
    ))}
  </div>
</section>
