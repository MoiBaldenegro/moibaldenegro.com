---
// Footer del layout único (feature 89, REQ-89-05..07): marca con CTA al CV, navegación,
// últimos artículos, redes del sprite y barra inferior con copyright y Volver arriba.
import { AboutRepository } from '../../domain/repositories/about-repository.ts';
import { HeroProfileRepository } from '../../domain/repositories/hero-profile-repository.ts';
import { PostsRepository } from '../../domain/repositories/posts-repository.ts';
import { FOOTER_LATEST_POSTS_LIMIT, latestPosts } from '../../domain/latest-posts.ts';
import { copyrightLine, footerColumns } from '../../domain/site-footer.ts';

const about = new AboutRepository().getProfile();
const profile = new HeroProfileRepository().getProfile();
const posts = latestPosts(await new PostsRepository().getPosts(), FOOTER_LATEST_POSTS_LIMIT);
const [navigation, social] = footerColumns(about);
---

<footer class="mx-footer">
  <div class="mx-footer__inner">
    <div class="mx-footer-brand">
      <a class="mx-logo" href="/home"><img src="/assets/mxvi_logo.webp" alt="Inicio — moisesbaldenegro.com" width="72" height="25" loading="lazy" decoding="async" /></a>
      <p class="mx-footer-brand__headline">{about.headline}</p>
      <p class="mx-footer-brand__location"><span aria-hidden="true">◉</span> {about.location}</p>
      <a class="mx-button mx-button--accent" href="/cv.pdf" download="moises-baldenegro-cv.pdf">Descargar CV <span aria-hidden="true">↓</span></a>
    </div>

    <nav class="mx-footer__column" aria-label={navigation.title}>
      <p class="mx-label">{navigation.title}</p>
      <ul class="mx-link-list">
        {navigation.links.map((link) => (
          <li><a class="mx-link mx-link--subtle" href={link.href}>{link.label}</a></li>
        ))}
      </ul>
    </nav>

    <section class="mx-footer__column" aria-label="Últimos artículos">
      <p class="mx-label">Últimos artículos</p>
      <ul class="mx-link-list">
        {posts.map((post) => (
          <li>
            <a class="mx-link mx-link--subtle mx-footer__post" href={`/posts/${post.id}`}>{post.title}</a>
            <span class="mx-meta mx-meta--mono">{post.created} · {post.readtime} min</span>
          </li>
        ))}
      </ul>
    </section>

    <nav class="mx-footer__column" aria-label={social.title}>
      <p class="mx-label">{social.title}</p>
      <ul class="mx-link-list">
        {social.links.map((link) => (
          <li>
            <a class="mx-link mx-link--subtle mx-social-link" href={link.href} rel="me noopener">
              <svg class="mx-social-link__icon" aria-hidden="true" focusable="false"><use href={`/assets/svg/sprite.svg#${link.icon}`} /></svg>
              {link.label}<span class="mx-visually-hidden"> (sitio externo)</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>

  <div class="mx-footer-bar">
    <p>{copyrightLine(profile.name)} · Hecho con Astro y desplegado en Cloudflare</p>
    <a class="mx-button mx-button--sm" href="#top">Volver arriba <span aria-hidden="true">↑</span></a>
  </div>
</footer>
