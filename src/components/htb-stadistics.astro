---
import { HTB_API_TOKEN as ENV_TOKEN, HTB_USER_ID as ENV_ID } from 'astro:env/server';

// @ts-ignore
import { env } from 'cloudflare:workers';

const HTB_API_TOKEN = ENV_TOKEN || env.HTB_API_TOKEN;
const HTB_USER_ID = ENV_ID || env.HTB_USER_ID;

type ProfileData = Record<string, unknown>;

// ENDPÓIJT SINTERESANTES
// const url = `https://labs.hackthebox.com/api/v5/user/profile/activity/${HTB_USER_ID}`;
// https://gubarz.github.io/unofficial-htb-api/

const getText = (item: ProfileData, key: string) => {
  const value = item[key];

  return typeof value === 'string' ? value : null;
};

const getNumber = (item: ProfileData, key: string) => {
  const value = item[key];

  return typeof value === 'number' ? value : null;
};
// ENDPÓIJT SINTERESANTES
const url = `https://labs.hackthebox.com/api/v4/user/profile/basic/${HTB_USER_ID}`;
let profile: ProfileData = {};

try {
  const res = await fetch(url, {
    headers: {
      'Authorization': `Bearer ${HTB_API_TOKEN}`,
      'Accept': 'application/json',
      'User-Agent': 'Astro-SSR-App'
    },
  });

  if (!res.ok) {
    throw new Error(`HTB API responded with ${res.status} ${res.statusText}`);
  }

  const data = await res.json();
  console.log('HTB profile response:', data);
  profile = typeof data?.profile === 'object' && data?.profile !== null ? data.profile : {};
} catch (error) {
  console.error('Error fetching HTB data:', error);
}
---

<section>
  <h2>Perfil HTB</h2>
  <p>Resumen rápido de tu cuenta en Hack The Box.</p>
  <p>Usuario: {HTB_USER_ID}</p>

  <ul>
    <li><strong>Nombre:</strong> {getText(profile, 'full_name') ?? getText(profile, 'name') ?? 'HTB'}</li>
    <li><strong>Nivel:</strong> {getText(profile, 'rank') ?? 'Sin rango'}</li>
    <li><strong>Puntos:</strong> {getNumber(profile, 'points') ?? 0}</li>
    <li><strong>Owns:</strong> {getNumber(profile, 'user_owns') ?? 0} user / {getNumber(profile, 'system_owns') ?? 0} root</li>
    <li><strong>País:</strong> {getText(profile, 'country_name') ?? 'N/D'}</li>
    <li><strong>Miembro desde:</strong> {getText(profile, 'joined_date') ?? 'N/D'}</li>
  </ul>
</section>