---
import { HTB_API_TOKEN as ENV_TOKEN, HTB_USER_ID as ENV_ID } from 'astro:env/server';
import { env } from 'cloudflare:workers';
import { HtbProfileRepository } from '../domain/repositories/htb-profile-repository.ts';
import { HTB_ISLAND_CACHE_CONTROL } from '../domain/http/cache-policy.ts';

const HTB_API_TOKEN = ENV_TOKEN || env.HTB_API_TOKEN;
const HTB_USER_ID = ENV_ID || env.HTB_USER_ID;

const profile = await new HtbProfileRepository(HTB_API_TOKEN, HTB_USER_ID).getProfileOrNull();
// REQ-49-03: la isla se pide por GET y es cacheable una hora.
Astro.response.headers.set('Cache-Control', HTB_ISLAND_CACHE_CONTROL);
// Feature 92: lista compacta dentro de la card HTB del grid del hero (htb-card.astro); clases mx-tile-stats (REQ-12-07).
---

<div class="mx-tile-stats">
  {profile && (
    <ul class="mx-tile-stats__list">
      <li class="mx-tile-stats__item">
        <span class="mx-tile-stats__label">Nivel</span>
        <span class="mx-tile-stats__value">{profile.rank ?? 'N/D'}</span>
      </li>
      <li class="mx-tile-stats__item">
        <span class="mx-tile-stats__label">Puntos</span>
        <span class="mx-tile-stats__value">{profile.points ?? 'N/D'}</span>
      </li>
      <li class="mx-tile-stats__item">
        <span class="mx-tile-stats__label">Owns</span>
        <span class="mx-tile-stats__value">{profile.userOwns ?? 'N/D'} user / {profile.systemOwns ?? 'N/D'} root</span>
      </li>
    </ul>
  )}
  {!profile && <p class="mx-tile-stats__empty">Estadísticas no disponibles</p>}
</div>
