---
import "../../styles/tokens.css";
import "../../styles/hero-section.css";
import "../../styles/profile-card.css";

import HeroCard from "../hero-card.astro";

import { HeroCardsRepository } from "../../domain/repositories/hero-cards-repository.ts";
import { HeroProfileRepository } from "../../domain/repositories/hero-profile-repository.ts";

const heroCards = new HeroCardsRepository().getCards();
const profile = new HeroProfileRepository().getProfile();
---

<section class="new-hero">
  <!-- Fondo -->
  <div class="hero-background">
    <div class="hero-gradient"></div>
  </div>

  <!-- Contenido -->
  <main class="hero-grid">
    <!-- HERO -->
    <section class="profile-card">
      <div class="profile-image">
        <img
          src={profile.image}
          alt={profile.name}
        />
        <div class="profile-overlay"></div>
        <div class="profile-username">
          <span>{profile.username}</span>
          {
            profile.verified && (
              <span class="verified">
                ✓
              </span>
            )
          }
        </div>
      </div>
      <div class="profile-content">
        <h1>{profile.name}</h1>
        <p>{profile.description}</p>
      </div>
    </section>

    <!-- Tarjetas -->
    {
      heroCards.map(card => (
        <HeroCard card={card} />
      ))
    }
  </main>
</section>
