---
// Feature 12 (REQ-12-01/02): hero Bento y tarjeta de perfil del design system MXVI; el movimiento es del sitio.
import "../../styles/hero-cards-motion.css";

import HeroGridCard from "../hero-cards/hero-grid-card.astro";

import { layoutHeroCards } from "../../domain/hero-grid-layout.ts";
import { HeroCardsRepository } from "../../domain/repositories/hero-cards-repository.ts";
import { HeroProfileRepository } from "../../domain/repositories/hero-profile-repository.ts";

const heroCards = layoutHeroCards(new HeroCardsRepository().getCards());
const profile = new HeroProfileRepository().getProfile();
---

<section class="mx-hero home-hero">
  <!-- Fondo -->
  <div class="mx-hero__background">
    <div class="mx-hero__glow"></div>
  </div>

  <!-- Contenido -->
  <div class="mx-bento">
    <!-- HERO -->
    <section class="mx-profile-card" data-cols="5" data-rows="6">
      <div class="mx-profile-card__image">
        <img
          transition:persist="hero-profile"
          src={profile.image}
          alt={profile.name}
          width="952"
          height="960"
          fetchpriority="high"
        />
      </div>
      <div class="mx-profile-card__content">
        <span class="mx-handle">
          <span>{profile.username}</span>
          {
            profile.verified && (
              <span class="mx-verified">
                <span aria-hidden="true">✓</span><span class="mx-visually-hidden">Verificado</span>
              </span>
            )
          }
        </span>
        <h1 class="mx-profile-card__name">{profile.name}</h1>
        <p class="mx-profile-card__description">{profile.description}</p>
      </div>
    </section>

    <!-- Tarjetas -->
    {
      heroCards.map(({ card, colSpan, rowSpan }) => (
        <HeroGridCard card={card} colSpan={colSpan} rowSpan={rowSpan} />
      ))
    }
  </div>
</section>

<script>
  // Feature 115: entrada y salida tipo lego de las cards del hero (GSAP aprobado, features 70/96).
  import { destroy, init } from './hero-cards-motion.ts';
  document.addEventListener('astro:page-load', () => init());
  document.addEventListener('astro:before-swap', () => destroy());
</script>
