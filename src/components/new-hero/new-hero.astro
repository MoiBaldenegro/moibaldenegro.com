---

<section class="portfolio">

    <nav class="navbar">
        <a href="/">Home</a>
        <a href="/about">About</a>
        <a href="https://x.com/moibaldenegro">@moibaldenegro</a>
    </nav>

    <div class="grid">

        <!-- HERO -->
        <article class="hero">

            <div class="image">

                <img src="assets/moises-hero.jpg" alt="moises">

                <div class="overlay"></div>

                <div class="username">
                    @moibaldenegro
                    <span>✔</span>
                </div>

            </div>

            <div class="info">

                <h1>Moisés Baldenegro Melendez</h1>

                <p class="subtitle">
                    Software engineering |
                    Rust |
                    Web Assembly |
                    Web Developer |
                    Multiplatform |
                    Devops infrastructure as code |
                    AWS |
                    Microsoft Azure |
                    Rustacean 🦀 |
                    Security first OWASP
                </p>

            </div>

        </article>

        <div class="card react">REACT</div>

        <div class="card html">HTML</div>

        <div class="card node">NODE JS</div>

        <div class="card github">GITHUB ACTIONS</div>

        <div class="card youtube">YOUTUBE</div>

        <div class="card twitch">TWITCH</div>

        <div class="card typescript">Typescript</div>

        <div class="card css">CSS</div>

        <div class="card node2">NODE JS</div>

        <div class="card github2">GITHUB ACTIONS</div>

        <div class="card youtube2">YOUTUBE</div>

        <div class="card twitch2">TWITCH</div>

    </div>

</section>

<style>

:root{

    --gap:12px;

}

body{
    margin:0;
}

.portfolio{

    min-height:100vh;

    background:#050017;

    color:white;

    padding:20px;

    font-family:Arial, Helvetica, sans-serif;

}

.navbar{

    display:flex;

    gap:40px;

    margin-bottom:20px;

}

.navbar a{

    color:white;

    text-decoration:none;

    font-size:18px;

}

.grid{

    max-width:1300px;

    margin:auto;

    display:grid;

    gap:var(--gap);

    grid-template-columns:repeat(12,1fr);
    grid-auto-rows:95px;

}

.hero{

    grid-column:1 / span 5;
    grid-row:1 / span 6;

    background:#111;

    border-radius:20px;

    overflow:hidden;

}

.image{

    position:relative;

    height:72%;

}

.image img{

    width:100%;
    height:100%;
    object-fit:cover;

}

.overlay{

    position:absolute;
    inset:0;

    background:linear-gradient(
        to top,
        rgba(0,0,0,.7),
        rgba(0,0,0,.1)
    );

}

.username{

    position:absolute;

    left:50%;
    bottom:18px;

    transform:translateX(-50%);

    background:#061621;

    color:#00bfff;

    padding:10px 30px;

    border-radius:30px;

    border:1px solid #00bfff;

    font-weight:bold;

}

.username span{

    margin-left:10px;

}

.info{

    padding:22px;

    text-align:center;

}

.info h1{

    margin:0;

    font-size:54px;

    line-height:1;

}

.subtitle{

    margin-top:15px;

    color:#ddd;

    font-size:20px;

    line-height:1.5;

}

/* Cards */

.card{

    border-radius:18px;

    display:flex;

    justify-content:center;

    align-items:flex-start;

    padding-top:18px;

    font-size:22px;

    position:relative;

    overflow:hidden;

    border:1px solid rgba(255,255,255,.08);

}

/* tamaños */

.react{
    grid-column:6/span 5;
    grid-row:1/span 2;
    background:#106980;
}

.html{
    grid-column:11/span 2;
    grid-row:1/span 2;
    background:#bb4300;
}

.node{
    grid-column:6/span 2;
    grid-row:3/span 2;
    background:#047c2f;
}

.github{
    grid-column:8/span 5;
    grid-row:3/span 2;
    background:#020718;
}

.youtube{
    grid-column:6/span 5;
    grid-row:5/span 2;
    background:#b50011;
}

.twitch{
    grid-column:11/span 2;
    grid-row:5/span 2;
    background:#6b15a6;
}

.typescript{
    grid-column:1/span 2;
    grid-row:7/span 2;
    background:#2846b7;
}

.css{
    grid-column:3/span 2;
    grid-row:7/span 2;
    background:#6820bb;
}

.node2{
    grid-column:5/span 2;
    grid-row:7/span 2;
    background:#137838;
}

.github2{
    grid-column:7/span 4;
    grid-row:7/span 2;
    background:#293241;
}

.youtube2{
    grid-column:11/span 2;
    grid-row:7/span 2;
    background:#bb1111;
}

.twitch2{
    grid-column:1/span 8;
    grid-row:9/span 2;
    background:#5c138c;
}

/* Decoración */

.card::after{

    content:"";

    position:absolute;

    width:140px;
    height:140px;

    right:-15px;
    bottom:-15px;

    border-radius:25px;

    background:rgba(255,255,255,.12);

    transform:rotate(-8deg);

    filter:blur(.2px);

}

/* Responsive */

@media (max-width:1100px){

.grid{

grid-template-columns:1fr;

grid-auto-rows:220px;

}

.hero,
.card{

grid-column:auto!important;
grid-row:auto!important;

}

.hero{

height:auto;

}

.info h1{

font-size:38px;

}

.subtitle{

font-size:16px;

}

}

</style>