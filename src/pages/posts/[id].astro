---
import "../../styles/post.css";
import "../../styles/post-header.css";
import "../../styles/post-readability.css";
import "../../styles/article.css";
import "../../styles/post-next.css";
import Layout from "../../layouts/Layout.astro";
import { PostsDataError, PostsRepository } from "../../domain/repositories/posts-repository.ts";
import { resolveRelatedTitles } from "../../domain/related-titles.ts";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  // DECISIÓN 2026-09-18 (colección unificada posts/): params.id = slug del
  // frontmatter, no entry.id (lleva subcarpeta architecture/ u os/).
  const posts = await new PostsRepository().getPosts();
  const entries = await getCollection("posts");
  if (entries.length !== posts.length) {
    throw new PostsDataError(
      "posts: la colección y el repositorio no coinciden en número de artículos",
    );
  }
  const postById = new Map(posts.map((post) => [post.slug, post]));
  return entries.map((entry) => {
    const slug = entry.data.slug;
    const post = postById.get(slug);
    if (!post) {
      throw new PostsDataError(`posts: no existe un post con id ${slug}`);
    }
    return {
      params: { id: slug },
      props: { post, entry, relatedLinks: resolveRelatedTitles(posts, post.related) },
    };
  });
}

const { post, entry, relatedLinks } = Astro.props;
const { title, author, readtime, img } = post;
const { Content } = await render(entry);

export const prerender = true;
---

<Layout title={title}>
  <main class="post">
    <header class="post__hero">
      <img transition:name={`img-${entry.id}`} src={`/assets/content/${img}`} alt={title} class="post__image" />
      <div class="post__hero-copy">
        <p class="post__kicker">#{post.tags[0]}</p>
        <h1 transition:name={`title-${entry.id}`} class="post__title">{title}</h1>
        <p class="post__meta">Por {author} • {readtime} min de lectura</p>
      </div>
    </header>
    <article class="post__content">
      <section class="post__body">
        <Content />
      </section>
    </article>
    {post.next && (
      <footer class="post__next">
        <a class="post__next-link" href={post.next}>Siguiente artículo</a>
      </footer>
    )}
    {post.related && (
      <section class="post__related">
        <h2 class="post__related-title">Recomendados</h2>
        <ul class="post__related-list">
          {relatedLinks.map((item) => (
            <li class="post__related-item">
              <img class="post__related-thumb" src={`/assets/content/${item.img}`} alt={item.title} loading="lazy" />
              <div class="post__related-body">
                <a class="post__related-link" href={item.href}>{item.title}</a>
                <p class="post__related-meta">Por {item.author} • {item.readtime} min</p>
              </div>
            </li>
          ))}
        </ul>
      </section>
    )}
  </main>
</Layout>
