---
import "../../styles/post.css";
import Layout from "../../layouts/Layout.astro";
import { PostsRepository } from "../../domain/repositories/posts-repository.ts";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const posts = await new PostsRepository().getPosts();
  const entries = await getCollection("architecture");
  if (entries.length !== posts.length) {
    throw new Error(
      "posts: la colección y el repositorio no coinciden en número de artículos",
    );
  }
  return entries.map((entry, index) => ({
    params: { id: entry.id },
    props: { post: posts[index], entry },
  }));
}

const { post, entry } = Astro.props;
const { title, author, readtime, img } = post;
const { Content } = await render(entry);

export const prerender = true;
---

<Layout title={title}>
  <main class="post">
    <article class="post__content">
      <h1 transition:name={`title-${entry.id}`} class="post__title">{title}</h1>
      <p class="post__meta">Por {author} • {readtime} min de lectura</p>
      <img transition:name={`img-${entry.id}`} src={`/assets/content/${img}`} alt={title} class="post__image" />
      <section>
        <Content />
      </section>
    </article>
  </main>
</Layout>