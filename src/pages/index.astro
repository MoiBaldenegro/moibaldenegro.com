---
import NewHero from '../components/new-hero/new-hero.astro';
import Layout from '../layouts/Layout.astro';
import LatestArticles from '../components/latest-articles.astro';
import HtbStadistics from '../components/htb-stadistics.astro';
import SearchLive from '../components/search-live/search-live.astro';
import { HeroProfileRepository } from '../domain/repositories/hero-profile-repository.ts';
import { SITE_DESCRIPTION } from '../domain/seo/head.ts';

export const prerender = true;

const profile = new HeroProfileRepository().getProfile();

// Feature 47: el índice ya no se embebe; el cliente lo pide a /search-index.json.
---

<Layout title={profile.name} description={SITE_DESCRIPTION}>
  <div class="home__landing" data-landing-sections>
    <NewHero/>
    <LatestArticles/>
    <HtbStadistics server:defer>
      <p slot="fallback">Cargando estadísticas de HTB...</p>
    </HtbStadistics>
  </div>
  <SearchLive />
</Layout>
