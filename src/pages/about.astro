---
import Layout from '../layouts/Layout.astro';
import AboutHero from '../components/about/about-hero.astro';
import AboutStats from '../components/about/about-stats.astro';
import AboutTimeline from '../components/about/about-timeline.astro';
import AboutSkills from '../components/about/about-skills.astro';
import AboutProjects from '../components/about/about-projects.astro';
import AboutContent from '../components/about/about-content.astro';
import AboutCredentials from '../components/about/about-credentials.astro';
import AboutPhilosophy from '../components/about/about-philosophy.astro';
import '../styles/about.css';
import { HeroProfileRepository } from '../domain/repositories/hero-profile-repository.ts';
import { AboutRepository } from '../domain/repositories/about-repository.ts';
import { SITE_DESCRIPTION } from '../domain/seo/head.ts';

const profile = new HeroProfileRepository().getProfile();
const about = new AboutRepository().getProfile();

export const prerender = true;

---

<Layout title="About — moisesbaldenegro.com" description={SITE_DESCRIPTION}>
  <div class="about">
    <AboutHero username={profile.username} description={profile.description} image={profile.image} about={about}>
      <h1 id="about-name" class="about-hero__name" slot="name">{profile.name}</h1>
    </AboutHero>
    <AboutStats stats={about.stats} />
    <AboutTimeline experience={about.experience} />
    <AboutSkills skills={about.skills} />
    <AboutProjects projects={about.projects} />
    <AboutContent content={about.content}>
      <p class="about__intro">{SITE_DESCRIPTION}</p>
    </AboutContent>
    <AboutCredentials education={about.education} certifications={about.certifications} languages={about.languages} />
    <AboutPhilosophy philosophy={about.philosophy} />
  </div>
</Layout>
