---
import Layout from '../layouts/Layout.astro';
import SearchResults from '../components/search-results/search-results.astro';
import { PostsRepository } from '../domain/repositories/posts-repository.ts';
import { buildSearchIndex } from '../domain/search/index.ts';
import { getCollection } from 'astro:content';

export const prerender = true;

// Índice embebido (REQ-03-07): catálogo + cuerpos markdown (solo en build,
// precedente posts/[id].astro), serializado con JSON.stringify y escape de
// </script (<\/script) para no romper el HTML.
const posts = await new PostsRepository().getPosts();
const entries = await getCollection('architecture');
const bodies = Object.fromEntries(entries.map((entry) => [entry.id, entry.body]));
const indexJson = JSON.stringify(buildSearchIndex(posts, bodies)).replace(
  /<\/script/gi,
  '<\\/script',
);
---

<Layout title="Búsqueda">
  <main class="search-page">
    <h1 class="search-page__heading">Búsqueda</h1>
    <script type="application/json" id="search-index" is:inline set:html={indexJson}></script>
    <SearchResults />
  </main>
</Layout>
