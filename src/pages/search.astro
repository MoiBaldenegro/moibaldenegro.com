---
import Layout from '../layouts/Layout.astro';
import SearchResults from '../components/search-results/search-results.astro';
import { SEARCH_DESCRIPTION } from '../domain/seo/head.ts';

export const prerender = true;

// Feature 47: el índice ya no se embebe; el cliente lo pide a /search-index.json.
---

<Layout title="Búsqueda" description={SEARCH_DESCRIPTION} noindex>
  <div class="mx-page">
    <h1 class="mx-heading mx-heading--page">Búsqueda</h1>
    <SearchResults />
  </div>
</Layout>
